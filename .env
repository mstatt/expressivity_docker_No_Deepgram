# No keys are needed for the default setup: Chrome transcribes the speech in the browser.

# How the browser and the bot exchange audio:
#   smallwebrtc  direct peer-to-peer, no account. Works with Docker Engine on Linux.
#   daily        through Daily's cloud. Use this on Docker Desktop (macOS / Windows). Needs DAILY_API_KEY.
# After changing it, run: docker compose up --build
TRANSPORT=smallwebrtc

# Only for TRANSPORT=daily (https://dashboard.daily.co/developers).
DAILY_API_KEY=

# The address this computer's browser reaches the bot's audio ports at. Leave as is first.
# If the page stays on "Connecting", put this computer's own network address here
# (for example 192.168.1.20: see `ipconfig` on Windows, `ifconfig` on macOS/Linux) and restart.
WEBRTC_HOST_IP=127.0.0.1
